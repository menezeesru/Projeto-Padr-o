# Ambiente - ServiceDesk Pro (desenvolvimento)
# Copie para .env na raiz ou configure por serviço

# Banco de dados
DATABASE_URL="postgresql://servicedesk:servicedesk@localhost:5432/servicedesk?schema=public"

# API
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=troque-este-segredo-jwt-em-producao-com-32+caracteres
JWT_REFRESH_SECRET=troque-este-segredo-refresh-em-producao-com-32+caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,txt,log,zip

# SMTP (opcional em dev)
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha
MAIL_FROM="ServiceDesk <nao-responder@seudominio.com.br>"

# App
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Segurança
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# SLA / Tarefas
TIMEZONE=America/Sao_Paulo
AUTO_CLOSE_RESOLVED_HOURS=72
ENABLE_SLA_ALERTS=true

# Admin inicial (seed)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@servicedesk.local"
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_ADMIN_DEPT="TI"
