import { useState } from "react";
import { useNavigate } from "react-router-dom";
import api from "../lib/api";
import { toast } from "sonner";
import { 
  FileText, 
  AlertCircle, 
  Send, 
  ArrowLeft,
  CheckCircle2,
  AlertTriangle,
  Info,
  BarChart3,
  FileCheck
} from "lucide-react";

export default function OpenTicket() {
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [impact, setImpact] = useState("MEDIO");
  const [urgency, setUrgency] = useState("MEDIA");
  const [categoryId, setCategoryId] = useState("");
  const [loading, setLoading] = useState(false);
  const [step, setStep] = useState(1);
  const navigate = useNavigate();

  const impactOptions = [
    { value: "BAIXO", label: "Baixo", desc: "Afeta um usuário ou funcionalidade menor", icon: Info, color: "border-blue-200 bg-blue-50 text-blue-700", selected: "border-[#2563EB] bg-blue-50 ring-2 ring-[#2563EB]/20" },
    { value: "MEDIO", label: "Médio", desc: "Afeta um grupo ou funcionalidade importante", icon: AlertCircle, color: "border-yellow-200 bg-yellow-50 text-yellow-700", selected: "border-[#EAB308] bg-yellow-50 ring-2 ring-[#EAB308]/20" },
    { value: "ALTO", label: "Alto", desc: "Afeta muitos usuários ou sistemas críticos", icon: AlertTriangle, color: "border-red-200 bg-red-50 text-red-700", selected: "border-[#EF4444] bg-red-50 ring-2 ring-[#EF4444]/20" }
  ];

  const urgencyOptions = [
    { value: "BAIXA", label: "Baixa", desc: "Não urgente, pode ser agendado", icon: Clock, color: "border-blue-200 bg-blue-50 text-blue-700", selected: "border-[#2563EB] bg-blue-50 ring-2 ring-[#2563EB]/20" },
    { value: "MEDIA", label: "Média", desc: "Pode aguardar no prazo normal", icon: AlertCircle, color: "border-yellow-200 bg-yellow-50 text-yellow-700", selected: "border-[#EAB308] bg-yellow-50 ring-2 ring-[#EAB308]/20" },
    { value: "ALTA", label: "Alta", desc: "Precisa de atenção imediata", icon: AlertTriangle, color: "border-red-200 bg-red-50 text-red-700", selected: "border-[#EF4444] bg-red-50 ring-2 ring-[#EF4444]/20" }
  ];

  const categories = [
    { value: "c9ac0cee-aa55-4853-944c-4b65c7fa1c30", label: "Falhas de Rede/Internet" },
    { value: "incidentes", label: "Incidentes de TI" },
    { value: "acesso", label: "Solicitação de Acesso" },
    { value: "software", label: "Instalação de Software" },
    { value: "hardware", label: "Problemas de Hardware" },
    { value: "email", label: "E-mail Corporativo" },
    { value: "outros", label: "Outros" }
  ];

  const getPriorityPreview = () => {
    if (impact === "ALTO" && urgency === "ALTA") return { label: "P1 - CRÍTICA", color: "text-red-700 bg-red-50 border-red-200" };
    if ((impact === "ALTO" && urgency === "MEDIA") || (impact === "MEDIO" && urgency === "ALTA")) return { label: "P2 - ALTA", color: "text-orange-700 bg-orange-50 border-orange-200" };
    if ((impact === "BAIXO" && urgency === "ALTA") || (impact === "MEDIO" && urgency === "BAIXA")) return { label: "P3 - MÉDIA", color: "text-yellow-700 bg-yellow-50 border-yellow-200" };
    return { label: "P4 - BAIXA", color: "text-blue-700 bg-blue-50 border-blue-200" };
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (step < 3) {
      if (step === 1 && (!title || !description)) {
        toast.error("Preencha o título e a descrição");
        return;
      }
      setStep(step + 1);
      return;
    }
    
    setLoading(true);
    try {
      const payload: any = { 
        title, 
        description, 
        impact, 
        urgency
      };
      if (categoryId && categoryId.trim() !== "") payload.categoryId = categoryId;
      const res = await api.post("/api/tickets", payload);
      toast.success(`Chamado ${res.data.number} criado com sucesso!`);
      navigate(`/chamado/${res.data.id}`);
    } catch (err: any) {
      toast.error(err.response?.data?.error || "Erro ao abrir chamado");
    } finally {
      setLoading(false);
    }
  };

  const priority = getPriorityPreview();

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <div className="flex items-center gap-4">
        <button 
          onClick={() => navigate(-1)}
          className="p-2 hover:bg-white rounded-lg border border-[#DCE4EF] transition-colors shadow-sm"
        >
          <ArrowLeft size={20} className="text-gray-600" />
        </button>
        <div>
          <h1 className="text-2xl font-bold text-[#1E293B]">Abrir Novo Chamado</h1>
          <p className="text-sm text-gray-600 mt-1">Descreva seu problema ou solicitação para o suporte de TI</p>
        </div>
      </div>

      <div className="bg-white border border-[#DCE4EF] rounded-xl p-6 shadow-sm">
        <div className="flex items-center justify-between">
          {[1, 2, 3].map((s, index) => (
            <div key={s} className="flex items-center flex-1">
              <div className="flex flex-col items-center gap-2">
                <div className={`flex items-center justify-center w-10 h-10 rounded-full border-2 font-semibold transition-all duration-200 ${
                  step > s 
                    ? "bg-green-500 border-green-500 text-white" 
                    : step === s
                      ? "bg-[#2563EB] border-[#2563EB] text-white"
                      : "bg-white border-[#DCE4EF] text-gray-400"
                }`}>
                  {step > s ? <CheckCircle2 size={20} /> : s}
                </div>
                <div className="text-center hidden sm:block">
                  <p className={`text-xs font-semibold ${step >= s ? "text-[#1E293B]" : "text-gray-400"}`}>
                    {s === 1 && "Informações Básicas"}
                    {s === 2 && "Impacto e Urgência"}
                    {s === 3 && "Revisão e Envio"}
                  </p>
                  <p className="text-xs text-gray-500">
                    {s === 1 && "Título e descrição"}
                    {s === 2 && "Classifique a solicitação"}
                    {s === 3 && "Confirme os dados"}
                  </p>
                </div>
              </div>
              {index < 2 && (
                <div className={`h-0.5 flex-1 mx-4 -mt-8 hidden sm:block ${step > s ? "bg-green-500" : "bg-[#DCE4EF]"}`} />
              )}
            </div>
          ))}
        </div>
      </div>

      <form onSubmit={handleSubmit}>
        {step === 1 && (
          <div className="bg-white border border-[#DCE4EF] rounded-xl shadow-sm">
            <div className="flex items-center gap-3 px-6 py-5 border-b border-[#DCE4EF]">
              <div className="w-10 h-10 bg-[#DBEAFE] rounded-lg flex items-center justify-center">
                <FileText size={20} className="text-[#2563EB]" />
              </div>
              <div>
                <h2 className="text-lg font-semibold text-[#1E293B]">Informações Básicas</h2>
                <p className="text-sm text-gray-600">Descreva claramente seu problema</p>
              </div>
            </div>
            <div className="p-6 space-y-5">
              <div className="space-y-2">
                <label className="text-sm font-medium text-[#334155]">
                  Título do Chamado <span className="text-red-500">*</span>
                </label>
                <input 
                  value={title} 
                  onChange={(e) => setTitle(e.target.value)} 
                  className="w-full px-3 py-2 border border-[#DCE4EF] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB]/20 focus:border-[#2563EB] transition-all" 
                  placeholder="Ex: Problema para acessar sistema X"
                  required 
                />
                <p className="text-xs text-gray-500">Seja breve e objetivo</p>
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium text-[#334155]">
                  Categoria
                </label>
                <select 
                  value={categoryId} 
                  onChange={(e) => setCategoryId(e.target.value)} 
                  className="w-full px-3 py-2 border border-[#DCE4EF] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB]/20 focus:border-[#2563EB] bg-white"
                >
                  <option value="">Selecione uma categoria (opcional)</option>
                  {categories.map(cat => (
                    <option key={cat.value} value={cat.value}>{cat.label}</option>
                  ))}
                </select>
              </div>

              <div className="space-y-2">
                <label className="text-sm font-medium text-[#334155]">
                  Descrição Detalhada <span className="text-red-500">*</span>
                </label>
                <textarea 
                  value={description} 
                  onChange={(e) => setDescription(e.target.value)} 
                  rows={8} 
                  className="w-full px-3 py-2 border border-[#DCE4EF] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB]/20 focus:border-[#2563EB] resize-none transition-all" 
                  placeholder="Descreva o problema com o máximo de detalhes: quando ocorreu, passos para reproduzir, mensagens de erro, etc."
                  required 
                />
                <p className="text-xs text-gray-500">{description.length} caracteres</p>
              </div>

              <div className="flex justify-end pt-2">
                <button 
                  type="submit" 
                  disabled={!title || !description}
                  className="px-5 py-2.5 bg-[#2563EB] text-white rounded-lg hover:bg-[#1D4ED8] transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 font-medium"
                >
                  Próximo
                  <ArrowLeft size={16} className="rotate-180" />
                </button>
              </div>
            </div>
          </div>
        )}

        {step === 2 && (
          <div className="bg-white border border-[#DCE4EF] rounded-xl shadow-sm">
            <div className="flex items-center gap-3 px-6 py-5 border-b border-[#DCE4EF]">
              <div className="w-10 h-10 bg-orange-50 rounded-lg flex items-center justify-center">
                <BarChart3 size={20} className="text-orange-600" />
              </div>
              <div>
                <h2 className="text-lg font-semibold text-[#1E293B]">Impacto e Urgência</h2>
                <p className="text-sm text-gray-600">Ajude-nos a priorizar seu chamado corretamente</p>
              </div>
            </div>

            <div className="p-6 space-y-6">
              <div>
                <label className="text-sm font-medium text-[#334155] mb-3 block">
                  Impacto <span className="text-red-500">*</span>
                </label>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                  {impactOptions.map(opt => {
                    const Icon = opt.icon;
                    const selected = impact === opt.value;
                    return (
                      <label 
                        key={opt.value}
                        className={`relative flex flex-col items-center gap-2 p-4 border-2 rounded-xl cursor-pointer transition-all duration-150 ${
                          selected ? opt.selected : `${opt.color.replace('text-', 'border-').split(' ')[0]} hover:shadow-sm`
                        }`}
                      >
                        <input
                          type="radio"
                          name="impact"
                          value={opt.value}
                          checked={impact === opt.value}
                          onChange={(e) => setImpact(e.target.value)}
                          className="sr-only"
                        />
                        <Icon size={24} className={selected ? opt.color.split(' ')[2] : opt.color.split(' ')[2]} />
                        <p className="font-semibold text-sm">{opt.label}</p>
                        <p className="text-xs text-center text-gray-600">{opt.desc}</p>
                      </label>
                    );
                  })}
                </div>
              </div>

              <div>
                <label className="text-sm font-medium text-[#334155] mb-3 block">
                  Urgência <span className="text-red-500">*</span>
                </label>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                  {urgencyOptions.map(opt => {
                    const Icon = opt.icon;
                    const selected = urgency === opt.value;
                    return (
                      <label 
                        key={opt.value}
                        className={`relative flex flex-col items-center gap-2 p-4 border-2 rounded-xl cursor-pointer transition-all duration-150 ${
                          selected ? opt.selected : `${opt.color.replace('text-', 'border-').split(' ')[0]} hover:shadow-sm`
                        }`}
                      >
                        <input
                          type="radio"
                          name="urgency"
                          value={opt.value}
                          checked={urgency === opt.value}
                          onChange={(e) => setUrgency(e.target.value)}
                          className="sr-only"
                        />
                        <Icon size={24} className={opt.color.split(' ')[2]} />
                        <p className="font-semibold text-sm">{opt.label}</p>
                        <p className="text-xs text-center text-gray-600">{opt.desc}</p>
                      </label>
                    );
                  })}
                </div>
              </div>

              <div className={`p-4 rounded-xl border ${priority.color}`}>
                <div className="flex items-center gap-2">
                  <AlertCircle size={20} />
                  <span className="font-semibold">Prioridade Calculada: {priority.label}</span>
                </div>
                <p className="text-sm mt-1 opacity-90">
                  Baseada na combinação de impacto e urgência
                </p>
              </div>

              <div className="flex justify-between pt-2">
                <button 
                  type="button"
                  onClick={() => setStep(1)}
                  className="px-4 py-2 bg-white border border-[#DCE4EF] text-[#334155] rounded-lg hover:bg-[#F8FAFC] transition-colors flex items-center gap-2 font-medium"
                >
                  <ArrowLeft size={16} />
                  Voltar
                </button>
                <button 
                  type="submit"
                  className="px-5 py-2.5 bg-[#2563EB] text-white rounded-lg hover:bg-[#1D4ED8] transition-colors flex items-center gap-2 font-medium"
                >
                  Próximo
                  <ArrowLeft size={16} className="rotate-180" />
                </button>
              </div>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="bg-white border border-[#DCE4EF] rounded-xl shadow-sm">
            <div className="flex items-center gap-3 px-6 py-5 border-b border-[#DCE4EF]">
              <div className="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
                <FileCheck size={20} className="text-green-600" />
              </div>
              <div>
                <h2 className="text-lg font-semibold text-[#1E293B]">Revisão e Envio</h2>
                <p className="text-sm text-gray-600">Confirme os dados antes de abrir o chamado</p>
              </div>
            </div>

            <div className="p-6 space-y-5">
              <div className="bg-[#F8FAFC] border border-[#DCE4EF] rounded-xl p-5 space-y-4">
                <div>
                  <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Título do Chamado</p>
                  <p className="text-sm text-[#1E293B] font-medium">{title}</p>
                </div>
                {categoryId && (
                  <div>
                    <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Categoria</p>
                    <p className="text-sm text-[#334155]">{categories.find(c => c.value === categoryId)?.label}</p>
                  </div>
                )}
                <div>
                  <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Descrição Detalhada</p>
                  <p className="text-sm text-[#334155] whitespace-pre-wrap leading-relaxed">{description}</p>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                  <div>
                    <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Impacto</p>
                    <p className="text-sm text-[#334155]">{impactOptions.find(i => i.value === impact)?.label}</p>
                  </div>
                  <div>
                    <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Urgência</p>
                    <p className="text-sm text-[#334155]">{urgencyOptions.find(u => u.value === urgency)?.label}</p>
                  </div>
                </div>
                <div>
                  <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Prioridade Calculada</p>
                  <span className={`inline-flex px-3 py-1 rounded-full text-xs font-semibold border ${priority.color}`}>
                    {priority.label}
                  </span>
                </div>
              </div>

              <div className="bg-blue-50 border border-blue-200 rounded-xl p-4 flex gap-3">
                <Info size={20} className="text-[#2563EB] flex-shrink-0 mt-0.5" />
                <div className="text-sm text-blue-900">
                  <p className="font-semibold">Após o envio</p>
                  <p className="mt-1">Seu chamado será recebido pela equipe de TI e receberá um número de protocolo único. Você poderá acompanhar o andamento na seção "Meus Chamados".</p>
                </div>
              </div>

              <div className="flex justify-between pt-2">
                <button 
                  type="button"
                  onClick={() => setStep(2)}
                  className="px-4 py-2 bg-white border border-[#DCE4EF] text-[#334155] rounded-lg hover:bg-[#F8FAFC] transition-colors flex items-center gap-2 font-medium"
                >
                  <ArrowLeft size={16} />
                  Voltar
                </button>
                <button 
                  type="submit" 
                  disabled={loading}
                  className="px-6 py-2.5 bg-[#2563EB] text-white rounded-lg hover:bg-[#1D4ED8] transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 font-medium shadow-sm"
                >
                  {loading ? (
                    <>
                      <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                      Enviando...
                    </>
                  ) : (
                    <>
                      <Send size={16} />
                      Abrir Chamado
                    </>
                  )}
                </button>
              </div>
            </div>
          </div>
        )}
      </form>
    </div>
  );
}
