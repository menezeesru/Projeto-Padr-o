DATABASE_URL="postgresql://servicedesk:servicedesk@localhost:5432/servicedesk?schema=public"
NODE_ENV=development
API_PORT=4000
JWT_SECRET=troque-este-segredo-jwt
JWT_REFRESH_SECRET=troque-este-segredo-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
TIMEZONE=America/Sao_Paulo
AUTO_CLOSE_RESOLVED_HOURS=72
ENABLE_SLA_ALERTS=true
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@servicedesk.local"
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_ADMIN_DEPT="TI"
WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ServiceDesk <nao-responder@servicedesk.local>"
